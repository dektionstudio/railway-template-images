#!/bin/sh
# Runs as root before the desktop starts (linuxserver custom init).
if [ ! -f /config/.railway-home ]; then
  date -u +%Y-%m-%dT%H:%M:%SZ > /config/.railway-home
  echo "[railway] new home directory on the volume"
else
  echo "[railway] home directory on the volume since $(cat /config/.railway-home)"
fi
mkdir -p /config/projects && chown "${PUID:-1000}:${PGID:-1000}" /config/projects /config/.railway-home
echo "[railway] node $(node --version) | claude $(claude --version 2>/dev/null | head -1) | codex $(codex --version 2>/dev/null | head -1) | $(/usr/bin/google-chrome-stable --version 2>/dev/null) | code $(/usr/bin/code --version --no-sandbox --user-data-dir /tmp/code-version 2>/dev/null | head -1)"
