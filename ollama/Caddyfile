{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# "Ollama is running": Railway's healthcheck, no model access.
	@root path /
	handle @root {
		reverse_proxy 127.0.0.1:11434
	}

	@authorized header Authorization "Bearer {$OLLAMA_API_KEY}"
	handle @authorized {
		reverse_proxy 127.0.0.1:11434 {
			flush_interval -1
		}
	}

	handle {
		respond "Unauthorized: send the header Authorization: Bearer <OLLAMA_API_KEY>" 401
	}
}
